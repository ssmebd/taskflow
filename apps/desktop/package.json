{
  "name": "taskflow-desktop",
  "version": "1.1.6",
  "description": "TaskFlow desktop app",
  "author": "GURUCADD",
  "main": "main.js",
  "private": true,
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis --publish never" },
  "devDependencies": { "electron": "33.2.1", "electron-builder": "25.1.8" },
  "build": {
    "appId": "com.gurucadd.taskflow",
    "productName": "TaskFlow",
    "icon": "icon.ico",
    "files": ["main.js", "preload.js", "tabpre.js", "chrome.html", "icon.png", "icon.ico", "package.json"],
    "win": { "target": "nsis", "icon": "icon.ico" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "runAfterFinish": true }
  }
}
